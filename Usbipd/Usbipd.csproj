<Project Sdk="Microsoft.NET.Sdk.Worker">

  <Import Project="../Platform.Build.props" />

  <PropertyGroup>
    <TargetFramework>$(MainTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPublishable>true</IsPublishable>
    <!--
    Not Native AOT: EF Core and SqlClient (the user database) do not fully support it.
    Still one usbipd.exe: self-contained single file, so the installer and the PATH stay as they are.
    -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- SqlClient needs culture data -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <AssemblyName>usbipd</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EfDesign)' == 'true'">
    <!-- dotnet ef only: the repository-wide pins (e.g. Roslyn for Win32ResourceGenerator) conflict with EF Core's design package -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <NuGetAudit>false</NuGetAudit>
    <!-- dotnet ef loads the app through its deps.json (the repository default turns it off) -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <!-- keep packages.lock.json as the shipped build needs it; the design-time lock file goes to obj -->
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)packages.efdesign.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ProjectDir" />
    <CompilerVisibleProperty Include="IntermediateOutputPath" />
    <CompilerVisibleProperty Include="Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Win32ResourceGenerator\Win32ResourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

  <Target Name="SetWin32Resource" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <Win32Resource>$(IntermediateOutputPath)generated\Win32ResourceGenerator\Resources.res</Win32Resource>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Compile Include="..\Usbipd.Automation\*.cs" LinkBase="Usbipd.Automation" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="NativeMethods.json" />
    <Content Remove="packages.lock.json" />
    <None Include="packages.lock.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\COPYING.md" Link="COPYING.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Usbipd.Automation\usb.ids" Link="usb.ids" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
    Design-time only (dotnet ef), so Roslyn does not end up in usbipd.exe. Set the environment variable EfDesign=true
    before running dotnet ef (see Data\Database.cs).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" Condition="'$(EfDesign)' == 'true'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- (generated) event provider manifest -->
    <Content
      Include="$(IntermediateOutputPath)generated\Win32ResourceGenerator\EventManifest.xml"
      Link="EventManifest.xml"
      CopyToOutputDirectory="PreserveNewest"
      />
  </ItemGroup>

  <Target Name="CopyManifestOnPublishNoBuild" AfterTargets="Publish">
    <Copy
      SourceFiles="$(IntermediateOutputPath)generated\Win32ResourceGenerator\EventManifest.xml"
      DestinationFiles="$(PublishDir)EventManifest.xml"
      SkipUnchangedFiles="true"
      />
  </Target>

  <ItemGroup>
    <!-- WSL -->
    <!-- Copy everything at the top level only, except the REUSE .license files (if any). -->
    <None Remove="WSL\**\*" />
    <Content Include="WSL\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="WSL\*.license" />
    <!-- Also copy everything in the platform directory moving it to the top level, except the REUSE .license files (if any). -->
    <Content Include="WSL\$(Platform)\*" Link="WSL\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="WSL\$(Platform)\*.license" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drivers -->
    <!-- Copy everything at the top level only, except the REUSE .license files (if any). -->
    <Content Include="..\Drivers\*" Link="Drivers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="..\Drivers\*.license" />
    <!-- Also copy everything in the platform directory moving it to the top level, except the REUSE .license files (if any). -->
    <Content Include="..\Drivers\$(Platform)\*" Link="Drivers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="..\Drivers\$(Platform)\*.license" />
  </ItemGroup>

</Project>
