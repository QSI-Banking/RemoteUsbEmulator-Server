<configuration>
  <!-- Without this, the DTF host (SfxCA) loads CLR 2.0 and cannot load a net472 assembly -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
